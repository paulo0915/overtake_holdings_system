# === Global Configuration ===

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Price threshold - minimum bid/price in USD
MIN_PRICE_USD=500000

# Vehicle filter file path
VEHICLE_FILTER_FILE=client_requirements/markets to track closely.xlsx

# FX API
FRANKFURTER_API_BASE=https://api.frankfurter.app

# Hagerty Marketplace GraphQL (public browser key; override if Hagerty rotates it)
HAGERTY_GRAPHQL_API_KEY=da2-ffvpvgysavcdnh6v4srbxe5fw4

# DuPont REGISTRY Live (NextAuth — optional but recommended for richer listing HTML)
DUPONT_LIVE_EMAIL=
DUPONT_LIVE_PASSWORD=

# Sotheby's Motorsport (NextAuth — required; Playwright is used for Cloudflare bypass)
SOTHEBYS_MOTORSPORT_EMAIL=
SOTHEBYS_MOTORSPORT_PASSWORD=
# Browser channel for Playwright — "chrome" uses system Google Chrome (recommended, bypasses Cloudflare).
# Set to "" to use bundled headless Chromium instead.
SOTHEBYS_PLAYWRIGHT_CHANNEL=chrome
# Session cookies are cached automatically in output/.sothebys_session_cache.json
# and reused until cf_clearance or the NextAuth token expires — no manual action needed.

# === Scraper Settings ===

# Max concurrent HTTP requests per scraper
MAX_CONCURRENT_REQUESTS=4

# Base delay between requests (seconds, jitter added automatically)
REQUEST_DELAY_SECONDS=1.5
