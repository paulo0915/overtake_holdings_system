# === Global Configuration ===

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Price threshold - minimum bid/price in USD
MIN_PRICE_USD=500000

# Vehicle filter file path
VEHICLE_FILTER_FILE=client_requirements/markets to track closely.xlsx

# FX API
FRANKFURTER_API_BASE=https://api.frankfurter.app

# Hagerty Marketplace GraphQL (public browser key; override if Hagerty rotates it)
HAGERTY_GRAPHQL_API_KEY=da2-ffvpvgysavcdnh6v4srbxe5fw4

# === Scraper Settings ===

# Max concurrent HTTP requests per scraper
MAX_CONCURRENT_REQUESTS=4

# Base delay between requests (seconds, jitter added automatically)
REQUEST_DELAY_SECONDS=1.5
